<section class="featured-carousel" data-featured-carousel aria-label="주요 글" aria-roledescription="캐러셀">
    <div class="featured-carousel__toolbar">
        <h2>FEATURED <small>지금 읽어볼 글</small></h2>
        <div class="featured-carousel__controls" hidden>
            <div class="featured-carousel__progress" aria-hidden="true"><span></span></div>
            <button type="button" data-featured-play aria-label="자동 재생 일시정지" aria-pressed="false">Ⅱ</button>
            <button type="button" data-featured-prev aria-label="이전 글" aria-controls="featured-posts">←</button>
            <span data-featured-position></span>
            <button type="button" data-featured-next aria-label="다음 글" aria-controls="featured-posts">→</button>
        </div>
    </div>
    <p class="featured-carousel__status" role="status">지금 읽어볼 글을 불러오는 중입니다.</p>
    <div class="featured-carousel__track" id="featured-posts" tabindex="0" aria-label="반응과 최신성을 반영한 추천 글" hidden></div>
    <template data-featured-candidates>
        {{#get "posts" include="tags" limit="all" as |candidates|}}
        {{#foreach candidates}}
        <a class="featured-carousel__slide" data-featured-slug="{{slug}}" data-featured-updated-at="{{date updated_at format="YYYY-MM-DDTHH:mm:ssZ"}}" href="{{url}}" aria-label="{{title}}">
            {{#if feature_image}}
                <img class="featured-carousel__image" src="{{img_url feature_image size="l"}}" alt="" width="1200" height="675" loading="lazy">
            {{/if}}
            <div class="featured-carousel__copy">
                <div class="featured-carousel__meta"><span data-featured-views></span>{{#primary_tag}}<span>{{name}}</span>{{/primary_tag}}<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY.MM.DD"}}</time></div>
                <div class="post-card__engagement featured-carousel__engagement" data-post-engagement data-post-slug="{{slug}}" role="group" aria-label="게시글 반응">
                    <span title="조회수" aria-label="조회수"><svg class="lucide lucide-eye" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg><b data-engagement-views>—</b></span>
                    <span title="댓글" aria-label="댓글"><svg class="lucide lucide-message-circle" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg><b data-engagement-comments>—</b></span>
                    <span title="좋아요" aria-label="좋아요"><svg class="lucide lucide-heart" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg><b data-engagement-likes>—</b></span>
                    <span title="공유" aria-label="공유"><svg class="lucide lucide-share-2" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg><b data-engagement-shares>—</b></span>
                </div>
                <h3>{{title}}</h3>
                {{#if excerpt}}<p>{{excerpt words="24"}}</p>{{/if}}
                <span class="featured-carousel__link">Read Entry <span aria-hidden="true">↗</span></span>
            </div>
        </a>
        {{/foreach}}
        {{/get}}
    </template>
</section>

