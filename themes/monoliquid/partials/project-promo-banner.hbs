<section class="project-promo" data-project-promo aria-label="프로젝트 광고" aria-live="off">
    <div class="project-promo__viewport">
        <a class="project-promo__slide is-active"
           data-project-promo-slide
           href="https://poli.it.kr"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="폴리 — 내 관심사로 받아보는 국회 소식, 새 탭에서 열기"
           aria-hidden="false">
            <img class="project-promo__image"
                 src="{{asset "images/project-ads/poli.webp"}}"
                 width="876"
                 height="76"
                 alt="">
        </a>

        <a class="project-promo__slide"
           data-project-promo-slide
           href="https://dohyeon-kr.github.io/free-rider/"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Free Rider — API 작업에 무임승차하세요, 새 탭에서 열기"
           aria-hidden="true"
           tabindex="-1">
            <img class="project-promo__image"
                 src="{{asset "images/project-ads/free-rider.webp"}}"
                 width="876"
                 height="76"
                 alt=""
                 loading="lazy">
        </a>
    </div>

    <div class="project-promo__controls">
        <span class="project-promo__ad-label">AD</span>
        <span class="project-promo__position" data-project-promo-position aria-hidden="true">01 / 02</span>
        <button class="project-promo__toggle"
                type="button"
                data-project-promo-toggle
                aria-label="프로젝트 배너 자동 전환 일시정지"
                aria-pressed="false">Ⅱ</button>
    </div>
</section>
