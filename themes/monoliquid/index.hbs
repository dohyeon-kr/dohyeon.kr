{{!< default}}

<main id="main-content" class="site-main">
    <section id="posts" class="post-index">
        <div class="post-grid">
            <div class="post-index__marquee" aria-label="Latest">
                <div class="post-index__marquee-track" aria-hidden="true">
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                    <span>Latest</span>
                </div>
            </div>

            {{#foreach posts to="5"}}
                {{> "post-card"}}
            {{/foreach}}

            {{#foreach posts from="6"}}
                {{> "post-card"}}
            {{/foreach}}
        </div>
    </section>

    {{pagination}}
</main>
