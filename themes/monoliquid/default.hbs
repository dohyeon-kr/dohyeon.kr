<!doctype html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#000000">
    <title>{{meta_title}}</title>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    {{#is "post"}}
        {{#post}}
            {{#unless feature_image}}
                <meta property="og:image" content="{{@site.url}}/assets/images/generated-thumbnails/{{slug}}.png">
                <meta property="og:image:width" content="1200">
                <meta property="og:image:height" content="630">
                <meta name="twitter:image" content="{{@site.url}}/assets/images/generated-thumbnails/{{slug}}.png">
            {{/unless}}
        {{/post}}
    {{/is}}
    {{ghost_head}}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZNSZPTYQM8"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-ZNSZPTYQM8', { anonymize_ip: true });
    </script>
</head>
<body class="{{body_class}}">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
        {{> "site-header"}}
        {{{body}}}
        {{> "site-footer"}}
    </div>
    <button class="back-to-top" type="button" data-back-to-top aria-label="맨 위로 이동" title="맨 위로" hidden>
        <span aria-hidden="true">↑</span>
    </button>
    <script defer src="{{asset "js/announcement-marquee.js"}}"></script>
    <script defer src="{{asset "js/admin-tools.js"}}"></script>
    <script defer src="{{asset "js/anonymous-comments.js"}}"></script>
    <script defer src="{{asset "js/generated-thumbnails.js"}}"></script>
    <script defer src="{{asset "js/infinite-scroll.js"}}"></script>
    <script defer src="{{asset "js/post-view-counter.js"}}"></script>
    <script defer src="{{asset "js/site-header.js"}}"></script>
    <script defer src="{{asset "js/visit-counter.js"}}"></script>
    <script defer src="{{asset "js/back-to-top.js"}}"></script>
    {{ghost_foot}}
</body>
</html>
