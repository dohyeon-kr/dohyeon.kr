{{!< default}}

<main id="main-content" class="site-main">
    {{#post}}
        <article class="article {{post_class}}">
            <header class="article-header wrapper--ticks">
                <div class="article-header__meta">
                    {{#primary_tag}}
                        <a href="{{url}}">{{name}}</a>
                    {{/primary_tag}}
                    <span>{{date format="YYYY.MM.DD"}}</span>
                    <span data-post-view-counter data-post-slug="{{slug}}" aria-live="polite">조회수 —</span>
                    <a class="article-admin-edit" href="/ghost/#/editor/post/{{id}}" data-admin-edit hidden>편집</a>
                    <a class="article-admin-edit" href="/ghost/dashboard/" data-admin-edit hidden>대시보드</a>
                </div>
                <h1>{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="article-header__dek">{{custom_excerpt}}</p>
                {{/if}}
            </header>

            {{#if feature_image}}
                <figure class="article-image">
                    <img
                        srcset="{{img_url feature_image size="s"}} 300w,
                                {{img_url feature_image size="m"}} 720w,
                                {{img_url feature_image size="l"}} 1200w,
                                {{img_url feature_image size="xl"}} 2000w"
                        sizes="(min-width: 980px) 860px, calc(100vw - 40px)"
                        src="{{img_url feature_image size="l"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        width="1200"
                        height="675"
                        fetchpriority="high"
                    >
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{else}}
                <figure class="article-image" data-generated-thumbnail>
                    <img
                        src="/assets/images/generated-thumbnails/{{slug}}.png"
                        alt="{{title}}"
                        width="1200"
                        height="630"
                        fetchpriority="high"
                    >
                </figure>
            {{/if}}

            <section class="gh-content gh-content--with-footer">
                {{content}}
            </section>

            <aside class="article-inbound" aria-labelledby="article-inbound-title">
                <p class="article-inbound__eyebrow">FROM WRITING TO WORK</p>
                <h2 id="article-inbound-title">비슷한 문제를 실제 제품에서 풀고 있다면.</h2>
                <p class="article-inbound__copy">아이디어의 MVP 구축, 운영 중인 서비스 개선, 업무 시스템화, AI 개발 워크플로우를 문제 정의부터 설계·개발·배포까지 함께 다룹니다. 완성된 기획서보다 지금 막혀 있는 지점부터 이야기해도 됩니다.</p>
                <div class="article-inbound__actions">
                    <a class="article-inbound__button article-inbound__button--primary" href="https://portfolio.dohyeon.kr/work-with-me/?ref=blog-post">프로젝트 상담하기 →</a>
                    <a class="article-inbound__button" href="https://portfolio.dohyeon.kr/">작업 사례 보기 ↗</a>
                </div>
            </aside>

            <section class="article-comments" data-anonymous-comments data-post-slug="{{slug}}">
                <div class="article-comments__inner">
                    <header class="article-comments__header">
                        <h2 class="article-comments__title">댓글 <span data-comment-count>0</span></h2>
                        <p>로그인 없이 익명으로 남길 수 있습니다.</p>
                    </header>
                    <div class="comment-list" data-comment-list aria-live="polite"></div>
                    <form class="comment-form" data-comment-form>
                        <label>이름 <span>(선택)</span><input name="displayName" maxlength="30" autocomplete="nickname" placeholder="익명"></label>
                        <label>댓글<textarea name="body" minlength="2" maxlength="2000" required placeholder="댓글을 입력해 주세요."></textarea></label>
                        <label class="comment-form__honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
                        <div class="comment-form__footer">
                            <span data-comment-status aria-live="polite">댓글을 불러오는 중…</span>
                            <button type="submit" disabled>댓글 남기기</button>
                        </div>
                    </form>
                    <noscript>댓글을 보거나 작성하려면 JavaScript를 켜 주세요.</noscript>
                </div>
            </section>

            <footer class="article-footer wrapper--ticks">
                <div class="tag-row">
                    {{#foreach tags}}
                        <a href="{{url}}">{{name}}</a>
                    {{/foreach}}
                </div>
            </footer>
        </article>
    {{/post}}
</main>
